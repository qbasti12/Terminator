{
  "$schema": "https://schema.tauri.app/2.0.0-beta/tauri.schema.json",
  "productName": "terminator",
  "version": "0.1.0",
  "identifier": "com.terminator.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Terminator",
        "width": 1000,
        "height": 700,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
